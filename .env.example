# ─────────────────────────────────────────────────────────────────────────────
# Convo — environment
# Copy to .env and fill in what you have. Convo runs fully without any of these:
# with no LLM key it uses the built-in deterministic model provider, and with no
# Razorpay keys it uses the mock Razorpay API (same request/response shapes).
# ─────────────────────────────────────────────────────────────────────────────

PORT=8787
NODE_ENV=development

# Where the browser reaches Convo. Used to build the shareable chat link.
PUBLIC_BASE_URL=http://localhost:5173

# SQLite file. Swap for Postgres later; the schema is written to port cleanly.
DATABASE_PATH=./data/convo.db

# 32+ random chars. Signs dashboard session cookies and encrypts provider
# credentials at rest (AES-256-GCM). Generate: openssl rand -hex 32
CONVO_SECRET=dev-only-insecure-secret-change-me-0000000000000000

# ── Model provider ───────────────────────────────────────────────────────────
# Which LLM runs inside the agent architecture. The agent's skills, gates, tools
# and audit logging are identical regardless of this value.
#   anthropic | openai | scripted
# "scripted" is a deterministic, no-network provider so the product is fully
# demonstrable without any API key. See DECISIONS.md.
LLM_PROVIDER=scripted

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# ── Razorpay ─────────────────────────────────────────────────────────────────
# TEST MODE ONLY. Keys are stored per tenant in the dashboard, not here; these
# are only defaults for seeding a demo tenant.
# Leave blank to use Convo's mock Razorpay API.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
